{
  "name": "atlas-private-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:client && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.jsonc --outdir ../../.preview/private-worker",
    "build:stage": "npm run build:client && node scripts/stage-worker.js --dry-run",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build:client": "node scripts/build-client.js",
    "build:gateway": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.validation-gateway.jsonc --outdir ../../.preview/validation-gateway"
  },
  "dependencies": {
    "dompurify": "3.4.18",
    "jose": "6.2.18",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.166.0"
  }
}
