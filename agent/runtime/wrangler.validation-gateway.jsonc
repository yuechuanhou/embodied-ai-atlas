{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-validation-gateway",
  "main": "src/validation-gateway.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "services": [{"binding": "BROKER", "service": "atlas-agent-private", "entrypoint": "ValidationBroker"}]
}
